# Copy to .env.local and fill in. Never commit real secrets.

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API URL (Production default is https://sprinkles-sparkles-backend.vercel.app)
NEXT_PUBLIC_API_URL=https://sprinkles-sparkles-backend.vercel.app

# Future server-only integrations (not wired yet — no NEXT_PUBLIC_ prefix)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
